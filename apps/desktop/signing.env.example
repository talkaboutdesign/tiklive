# Local signing and notarization for `bun run dist:mac:signed`.
# Copy to .env.signing (gitignored) and fill in. Never commit the real file.
#
# Signing uses the "Developer ID Application" certificate in your login keychain.
# To sign from a .p12 instead (as CI does), set CSC_LINK=/path/to/cert.p12 and CSC_KEY_PASSWORD.

# Notarization: App Store Connect API key (Users and Access → Integrations → Team Keys)
APPLE_API_KEY=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
APPLE_API_KEY_ID=XXXXXXXXXX
APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000
APPLE_TEAM_ID=U953KRFKF3
