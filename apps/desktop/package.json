{
  "name": "@tiklive/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Electron desktop shell for tiklive: runs the event server locally and shows the dashboard",
  "license": "MIT",
  "author": "talkaboutdesign",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack && node scripts/start-electron.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vp test run",
    "dist": "vp pack && electron-builder --publish never",
    "dist:mac": "vp pack && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "dist:mac:signed": "test -f .env.signing || { echo 'Missing apps/desktop/.env.signing (see signing.env.example)'; exit 1; } && vp pack && bun --env-file=.env.signing run electron-builder --mac --publish never",
    "dist:win": "vp pack && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@tiklive/client": "workspace:*",
    "@tiklive/server": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-updater": "^6.8.9",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "productName": "tiklive"
}
