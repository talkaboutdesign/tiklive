{
  "name": "@tiklive/client",
  "version": "0.1.0",
  "description": "Typed browser/Node client for tiklive servers. Zero runtime dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/talkaboutdesign/tiklive",
    "directory": "packages/client"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tiklive.js": "./dist/tiklive.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --target browser --format esm --outfile dist/tiklive.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "vp test run"
  },
  "dependencies": {
    "@tiklive/contracts": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:"
  }
}
