{
  "name": "@tiklive/client",
  "version": "0.0.0",
  "description": "Typed browser/Node client for tiklive servers. Zero runtime dependencies.",
  "keywords": [
    "livestream",
    "obs",
    "overlay",
    "tiktok",
    "tiktok-live",
    "webcast"
  ],
  "homepage": "https://github.com/talkaboutdesign/tiklive#readme",
  "bugs": {
    "url": "https://github.com/talkaboutdesign/tiklive/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/talkaboutdesign/tiklive",
    "directory": "packages/client"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@tiklive/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./tiklive.js": "./dist/tiklive.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && bun build src/index.ts --target browser --format esm --outfile dist/tiklive.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "vp test run",
    "prepack": "cp ../../LICENSE LICENSE"
  },
  "dependencies": {
    "@tiklive/contracts": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:"
  }
}
