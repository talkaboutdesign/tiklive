{
  "name": "@tiklive/client",
  "version": "0.3.0",
  "private": true,
  "description": "Typed browser/Node client for tiklive servers. Zero runtime dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talkaboutdesign/tiklive.git",
    "directory": "packages/client"
  },
  "type": "module",
  "exports": {
    ".": {
      "@tiklive/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./tiklive.js": "./dist/tiklive.js"
  },
  "scripts": {
    "build": "vp pack && bun build src/index.ts --target browser --format esm --outfile dist/tiklive.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "vp test run"
  },
  "dependencies": {
    "@tiklive/contracts": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:"
  }
}
