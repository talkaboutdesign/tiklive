{
  "name": "@tiklive/core",
  "version": "0.3.0",
  "private": true,
  "description": "Connect to TikTok LIVE and receive typed events. No signing service required.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talkaboutdesign/tiklive.git",
    "directory": "packages/core"
  },
  "type": "module",
  "exports": {
    ".": {
      "@tiklive/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "@tiklive/source": "./src/testing.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vp test run",
    "build": "vp pack"
  },
  "dependencies": {
    "@tiklive/contracts": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.2"
  }
}
