{
  "name": "tiklive",
  "version": "0.4.0",
  "description": "TikTok LIVE connector and self-hosted event server for overlays and apps",
  "keywords": [
    "livestream",
    "obs",
    "overlay",
    "tiktok",
    "tiktok-live",
    "webcast"
  ],
  "homepage": "https://github.com/talkaboutdesign/tiklive#readme",
  "bugs": {
    "url": "https://github.com/talkaboutdesign/tiklive/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talkaboutdesign/tiklive.git",
    "directory": "packages/server"
  },
  "bin": {
    "tiklive": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/bin.mjs",
    "./src/bin.ts"
  ],
  "exports": {
    ".": {
      "@tiklive/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./core": {
      "@tiklive/source": "./src/core.ts",
      "types": "./dist/core.d.mts",
      "default": "./dist/core.mjs"
    },
    "./contracts": {
      "@tiklive/source": "./src/contracts.ts",
      "types": "./dist/contracts.d.mts",
      "default": "./dist/contracts.mjs"
    },
    "./client": {
      "@tiklive/source": "./src/client.ts",
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    },
    "./testing": {
      "@tiklive/source": "./src/testing.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    },
    "./bun": {
      "@tiklive/source": "./src/platform/bun.ts",
      "types": "./dist/platform/bun.d.mts",
      "default": "./dist/platform/bun.mjs"
    },
    "./node": {
      "@tiklive/source": "./src/platform/node.ts",
      "types": "./dist/platform/node.d.mts",
      "default": "./dist/platform/node.mjs"
    },
    "./tiklive.js": "./dist/tiklive.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "bun ../../scripts/embed-assets.ts --ensure && tsc --noEmit -p .",
    "test": "vp test run",
    "dev": "bun --conditions=@tiklive/source --watch src/bin.ts",
    "build": "test -f ../client/dist/tiklive.js || { echo 'Build @tiklive/client first (bun run build at the repo root)'; exit 1; }; vp pack && cp ../client/dist/tiklive.js dist/tiklive.js && rm -rf dist/overlays && cp -R ../../examples/overlays dist/overlays && rm dist/overlays/package.json",
    "prepack": "cp ../../LICENSE LICENSE"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.2",
    "@effect/platform-node": "^4.0.2"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@tiklive/client": "workspace:*",
    "@tiklive/contracts": "workspace:*",
    "@tiklive/core": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.2"
  }
}
