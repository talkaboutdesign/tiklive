{
  "name": "@tiklive/server",
  "version": "0.1.0",
  "description": "Self-hosted TikTok LIVE event server for overlays and apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/talkaboutdesign/tiklive",
    "directory": "packages/server"
  },
  "bin": {
    "tiklive": "./src/bin.ts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bun": "./src/platform/bun.ts",
    "./node": "./src/platform/node.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vp test run",
    "dev": "bun --watch src/bin.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@tiklive/client": "workspace:*",
    "@tiklive/contracts": "workspace:*",
    "@tiklive/core": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:"
  }
}
