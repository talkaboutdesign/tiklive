{
  "name": "@tiklive/monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*",
      "apps/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.0.2",
      "@effect/platform-node": "4.0.2",
      "@effect/vitest": "4.0.2",
      "@types/bun": "1.4.2",
      "@types/node": "26.6.4",
      "effect": "4.0.2",
      "typescript": "7.0.2",
      "vite-plus": "1.1.0"
    }
  },
  "type": "module",
  "scripts": {
    "desktop:dev": "bun run --filter @tiklive/client build && bun run --filter @tiklive/desktop dev",
    "dev": "bun run --filter @tiklive/client build && bun --conditions=@tiklive/source --watch packages/server/src/bin.ts --static examples/overlays",
    "start": "bun run --filter @tiklive/client build && bun --conditions=@tiklive/source packages/server/src/bin.ts --static examples/overlays",
    "build": "bun run --filter './packages/*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun --bun vp test run",
    "test:node": "vp test run",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check && bun run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release": "bun scripts/release.ts",
    "build:binaries": "bun scripts/build-binaries.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.3",
  "patchedDependencies": {
    "@effect/vitest@4.0.2": "patches/@effect%2Fvitest@4.0.2.patch"
  }
}
